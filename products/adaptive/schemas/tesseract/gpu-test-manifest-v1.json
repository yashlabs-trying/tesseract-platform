{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tesseract.adaptive.gpu-test-manifest.v1",
  "title": "Tesseract Adaptive GPU Test Manifest",
  "description": "Pinned GPU validation manifest: model, profile, hardware, workload, thresholds.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "model_id",
    "profile",
    "hardware",
    "workload",
    "thresholds",
    "calibration_dataset",
    "evaluation_dataset"
  ],
  "properties": {
    "schema_version": { "const": "tesseract.adaptive.gpu-test-manifest.v1" },
    "name": { "type": "string" },
    "model_id": { "type": "string" },
    "model_revision": { "type": ["string", "null"] },
    "profile": {
      "type": "object",
      "required": ["bits", "method"],
      "properties": {
        "bits": { "enum": [4, 8] },
        "method": { "type": "string" },
        "group_size": { "type": ["integer", "null"] },
        "scheme": { "type": "string" },
        "granularity": { "type": "string" }
      }
    },
    "hardware": {
      "type": "object",
      "required": ["gpu_model", "vram_gb"],
      "properties": {
        "gpu_model": { "type": "string" },
        "gpu_count": { "type": "integer", "minimum": 1 },
        "vram_gb": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1 },
        "input_tokens": { "type": "integer", "minimum": 1 },
        "output_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["ttft_p95_ms", "itl_p95_ms"],
      "properties": {
        "ttft_p95_ms": { "type": "number", "exclusiveMinimum": 0 },
        "itl_p95_ms": { "type": "number", "exclusiveMinimum": 0 },
        "min_throughput_tps": { "type": "number", "minimum": 0 },
        "max_perplexity_degradation": { "type": "number", "minimum": 0 }
      }
    },
    "calibration_dataset": { "type": "string" },
    "evaluation_dataset": { "type": "string" },
    "seed": { "type": "integer" }
  },
  "additionalProperties": false
}
