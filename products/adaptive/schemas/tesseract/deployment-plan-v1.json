{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tesseract.adaptive.deployment-plan.v1",
  "title": "Tesseract Adaptive Deployment Plan",
  "description": "Backend-specific, non-executing deployment plan for a precision profile.",
  "type": "object",
  "required": ["schema_version", "backend", "method", "profile_id", "evidence"],
  "properties": {
    "schema_version": { "const": "tesseract.adaptive.deployment-plan.v1" },
    "backend": {
      "enum": [
        "torch_eager",
        "torch_compile",
        "mps",
        "cuda",
        "vllm",
        "sglang",
        "tensorrt_llm",
        "llama_cpp"
      ]
    },
    "method": {
      "enum": [
        "reference",
        "gptq",
        "awq",
        "bitsandbytes_int8",
        "bitsandbytes_nf4",
        "fp8",
        "gguf"
      ]
    },
    "profile_id": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "calibration_required": { "type": "boolean" },
    "calibration_samples": { "type": "integer", "minimum": 0 },
    "group_size": { "type": ["integer", "null"] },
    "expected_weight_bytes": { "type": "integer", "minimum": 0 },
    "estimated_prepare_time_s": { "type": "number", "minimum": 0 },
    "supported_bits": { "type": "array", "items": { "enum": [4, 8, 16, 32] } },
    "executable_here": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "evidence": { "enum": ["synthetic", "estimated", "measured", "validated"] }
  },
  "additionalProperties": false
}
