{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tesseract.adaptive.telemetry-snapshot.v1",
  "title": "Tesseract Adaptive Telemetry Snapshot",
  "description": "Point-in-time serving telemetry (measured or simulated).",
  "type": "object",
  "required": ["schema_version", "memory_pressure", "evidence"],
  "properties": {
    "schema_version": { "const": "tesseract.adaptive.telemetry-snapshot.v1" },
    "timestamp_s": { "type": "number" },
    "memory_pressure": { "type": "number", "minimum": 0, "maximum": 1 },
    "memory_used_gb": { "type": "number", "minimum": 0 },
    "memory_total_gb": { "type": "number", "minimum": 0 },
    "queue_depth": { "type": "integer", "minimum": 0 },
    "ttft_ms": { "type": "number", "minimum": 0 },
    "itl_ms": { "type": "number", "minimum": 0 },
    "tokens_per_second": { "type": "number", "minimum": 0 },
    "model_demand": { "type": "number", "minimum": 0 },
    "evidence": { "enum": ["synthetic", "estimated", "measured", "validated"] }
  },
  "additionalProperties": false
}
