# Tesseract Platform environment configuration.
# Copy to .env and adjust. Never commit real credentials.

# --- Control plane ---
TESSERACT_STATE_DSN=sqlite:///./var/platform.db
TESSERACT_API_HOST=0.0.0.0
TESSERACT_API_PORT=8088
TESSERACT_LOG_LEVEL=INFO

# --- Foundry (profiling / measurement) ---
TESSERACT_FOUNDRY_URL=http://localhost:8001
TESSERACT_FOUNDRY_API_KEY=

# --- Fusion (placement / reservations) ---
TESSERACT_FUSION_URL=http://localhost:8002
TESSERACT_FUSION_API_KEY=

# --- Ignite (deployment / routing) ---
TESSERACT_IGNITE_PROXY_URL=http://localhost:8080
TESSERACT_IGNITE_NAMESPACE=tesseract
TESSERACT_IGNITE_KUBECONFIG=

# --- Optimization controller ---
# observe_only | recommendation | controlled_action
TESSERACT_CONTROLLER_MODE=observe_only
TESSERACT_CONTROLLER_COOLDOWN_SECONDS=120
TESSERACT_CONTROLLER_ACTION_BUDGET=0

# --- Adaptive (optional, disabled by default) ---
TESSERACT_ADAPTIVE_ENABLED=false
TESSERACT_ADAPTIVE_URL=
