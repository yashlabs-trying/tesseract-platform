{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tesseract.platform.lifecycle.v1",
  "title": "Tesseract Platform Lifecycle Transition",
  "description": "An append-only audit record of a single state transition. Every transition on a reservation or deployment produces exactly one record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "tesseract.platform.lifecycle.v1" },
    "entity_type": { "enum": ["operation", "reservation", "deployment"] },
    "entity_id": { "type": "string" },
    "operation_id": { "type": "string" },
    "from_state": { "type": ["string", "null"] },
    "to_state": { "type": "string" },
    "reason": { "type": "string" },
    "actor": {
      "type": "string",
      "description": "Component that drove the transition, e.g. coordinator, reconciler, operator, client."
    },
    "correlation_id": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schema_version",
    "entity_type",
    "entity_id",
    "operation_id",
    "from_state",
    "to_state",
    "timestamp"
  ]
}
