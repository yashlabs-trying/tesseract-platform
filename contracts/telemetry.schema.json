{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tesseract.platform.telemetry.v1",
  "title": "Tesseract Platform Telemetry Event",
  "description": "Request-level and lifecycle telemetry emitted by Ignite and measured by Foundry. Failed/incomplete requests MUST set success=false and MUST NOT contribute to successful throughput.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "tesseract.platform.telemetry.v1" },
    "event_id": { "type": "string" },
    "correlation_id": {
      "type": "string",
      "description": "Stable ID preserved across the whole lifecycle (request -> deployment -> release)."
    },
    "workload_id": { "type": "string" },
    "deployment_id": { "type": "string" },
    "reservation_id": { "type": "string" },
    "event_type": {
      "enum": [
        "cold_start",
        "deployment_startup",
        "readiness",
        "queue_wait",
        "request",
        "scale_event",
        "release"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "cold_start_ms": { "type": "number", "minimum": 0 },
    "deployment_startup_ms": { "type": "number", "minimum": 0 },
    "readiness_ms": { "type": "number", "minimum": 0 },
    "queue_wait_ms": { "type": "number", "minimum": 0 },
    "ttft_ms": { "type": "number", "minimum": 0 },
    "itl_ms": { "type": "number", "minimum": 0 },
    "request_latency_ms": { "type": "number", "minimum": 0 },
    "tokens_input": { "type": "integer", "minimum": 0 },
    "tokens_output": { "type": "integer", "minimum": 0 },
    "success": { "type": "boolean" },
    "replica_count": { "type": "integer", "minimum": 0 },
    "evidence": { "enum": ["synthetic", "estimated", "measured", "validated"] },
    "source": { "type": "string", "description": "Emitting component, e.g. ignite-proxy, foundry-benchmark." }
  },
  "required": [
    "schema_version",
    "event_id",
    "correlation_id",
    "workload_id",
    "event_type",
    "timestamp",
    "evidence",
    "source"
  ]
}
