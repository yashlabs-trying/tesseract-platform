{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tesseract.platform.reservation.v1",
  "title": "Tesseract Platform Capacity Reservation",
  "description": "The durable record of a Fusion capacity reservation for a workload. The state field is the single source of truth for the reservation lifecycle and is reconciled against Kubernetes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "tesseract.platform.reservation.v1" },
    "reservation_id": { "type": "string" },
    "operation_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "workload_id": { "type": "string" },
    "state": {
      "enum": [
        "PENDING",
        "RESERVING",
        "RESERVED",
        "DEPLOYING",
        "READY",
        "ACTIVE",
        "RELEASING",
        "RELEASED",
        "FAILED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic version used for optimistic concurrency control."
    },
    "placement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gpu_id", "node_id"],
        "properties": {
          "gpu_id": { "type": "string" },
          "node_id": { "type": "string" },
          "gpu_model": { "type": "string" },
          "memory_mb": { "type": "integer", "minimum": 0 },
          "isolation": { "type": "string" },
          "evidence": { "enum": ["synthetic", "estimated", "measured", "validated"] }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu_count": { "type": "integer", "minimum": 0 },
        "gpu_hours": { "type": "number", "minimum": 0 },
        "cost_per_hour": { "type": "number", "minimum": 0 }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Reservations past this time are released by the reconciler if not committed."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "failure_reason": { "type": "string" }
  },
  "required": [
    "schema_version",
    "reservation_id",
    "operation_id",
    "idempotency_key",
    "workload_id",
    "state",
    "revision"
  ]
}
